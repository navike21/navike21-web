{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@Assets/*": ["./src/libs/assets/*"],
      "@Components/*": ["./src/libs/components/*"],
      "@Constants/*": ["./src/libs/constants/*"],
      "@Context/*": ["./src/libs/context/*"],
      "@Hooks/*": ["./src/libs/hooks/*"],
      "@Language/*": ["./src/libs/language/*"],
      "@Sources/*": ["./src/libs/sources/*"],
      "@Styles/*": ["./src/libs/styles/*"],
      "@Types/*": ["./src/libs/types/*"],
      "@Helpers/*": ["./src/libs/helpers/*"],
      "@Pages/*": ["./src/libs/pages/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
