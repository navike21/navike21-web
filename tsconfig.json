{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": "./src/",
    "paths": {
      "@Components/*": ["./libs/components/*"],
      "@Config/*": ["./libs/config/*"],
      "@Enums/*": ["./libs/enums/*"],
      "@Providers/*": ["./libs/providers/*"],
      "@Theme/*": ["./libs/theme/*"],
      "@Types/*": ["./libs/types/*"],
      "@Utils/*": ["./libs/utils/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
