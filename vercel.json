{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run validate && pnpm run build:ci",
  "devCommand": "pnpm dev",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "feature/refactor-project-nextjs": true
    }
  },
  "github": {
    "silent": false,
    "autoJobCancelation": true
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD ./"
}
